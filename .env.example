SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_REDIRECT_URI=vibra://spotify-callback
BANDSINTOWN_APP_ID=your-bandsintown-app-id

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Never put these in the Flutter .env: configure them with `supabase secrets set`.
# SUPABASE_SERVICE_ROLE_KEY=server-only
# SPOTIFY_CLIENT_SECRET=server-only
# SPOTIFY_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key-server-only
# Ticketmaster and Songkick keys belong only in backend secrets.
